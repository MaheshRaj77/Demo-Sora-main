<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config — PUnova
  - HTTPS required for all production traffic
  - Cleartext allowed only for localhost and Android emulator (10.0.2.2)
    so development builds can still reach a local backend server
-->
<network-security-config>
    <!-- Production: require HTTPS for the live backend -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">onrender.com</domain>
    </domain-config>

    <!-- Development only: allow HTTP to localhost and Android emulator -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- Default: block all other cleartext traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
